# Web development uses the Vite /api proxy by default.
# Android emulator debug build, requiring the local backend:
# VITE_API_BASE_URL=http://10.0.2.2:8000/api

# Public JavaScript app key from Kakao Developers (never use a REST secret).
# Register the public web origin in JS SDK domains and product link domains.
# VITE_KAKAO_JAVASCRIPT_KEY=
