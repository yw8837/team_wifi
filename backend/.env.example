# Local development only. Copy to .env; never commit your real values.
# SQLite is the default; DATABASE_URL is optional.
# DATABASE_URL=postgresql+psycopg://modu:replace-this-password@127.0.0.1:5432/modu
# RUNTIME_DIR=./runtime

# Optional social login, server-only. Configure only after provider application approval.
# Never prefix secrets with VITE_ or include them in an Android/web bundle.
# Google web client callback: PUBLIC_ORIGIN/api/auth/social/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Kakao REST API key (OIDC enabled) and its client secret:
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# Kakao callback: PUBLIC_ORIGIN/api/auth/social/kakao/callback
# PUBLIC_WEB_ORIGIN=https://moduyuga.onrender.com

# Optional Naver OAuth2 (not the separate Naver OIDC endpoint):
# Configure the registered application's consent items for the stable member ID only.
# Do not request email, name, birthday, phone, or profile image.
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# Naver callback: PUBLIC_ORIGIN/api/auth/social/naver/callback
# Missing either credential leaves Naver absent from /api/auth/social/providers.
