# Local development only. Copy to .env; never commit your real values.
# SQLite is the default; DATABASE_URL is optional.
# DATABASE_URL=postgresql+psycopg://modu:replace-this-password@127.0.0.1:5432/modu
# RUNTIME_DIR=./runtime

# Optional OIDC, server-only. Configure only after provider application approval.
# Never prefix secrets with VITE_ or include them in an Android/web bundle.
# Google web client callback: PUBLIC_ORIGIN/api/auth/social/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Kakao REST API key (OIDC enabled) and its client secret:
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# Kakao callback: PUBLIC_ORIGIN/api/auth/social/kakao/callback
# PUBLIC_WEB_ORIGIN=https://moduyuga.onrender.com
